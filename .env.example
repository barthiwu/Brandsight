# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already covered by .gitignore's `.env*` rule.

# --- Supabase ---------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The publishable/anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# The secret/service_role key — server-only, bypasses Row Level Security.
# NEVER expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to gpt-5.6-luna (see src/lib/ai/client.ts) if unset.
OPENAI_MODEL=gpt-5.6-luna

# --- App ------------------------------------------------------------------
# Used to build absolute URLs (share links, sitemap, metadata, robots.txt).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of emails granted access to /admin
# (see src/lib/security/adminAuth.ts).
ADMIN_EMAILS=you@example.com

# Supabase Storage bucket used for uploaded brand assets
# (created by supabase/migrations/0006_storage.sql).
STORAGE_BUCKET_NAME=brand-assets

# --- Lead notifications (BlitzSMA funnel) ---------------------------------
# Optional — when both are set, the auditing team gets an email whenever a
# new lead lands (from either the public shared-report form or the
# self-audit opt-in on a completed audit's own report page). Left unset,
# lead capture still works exactly the same; the team just has to check
# /admin/leads manually instead of getting notified. Get a key at
# https://resend.com — see src/lib/notifications/leadNotification.ts.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
LEAD_NOTIFICATION_EMAIL=team@example.com
# Optional — defaults to Resend's own onboarding sender (works with no
# setup). Switch to your own domain once it's verified in Resend.
# LEAD_NOTIFICATION_FROM_EMAIL=BrandSight <leads@yourdomain.com>
# The same Resend account is also reused, with no extra setup, for
# best-effort admin alerts (a pipeline failure, or an audit admitted over
# the capacity cap) — see src/lib/notifications/adminAlert.ts.

# --- Capacity & abuse guardrails ("devil's advocate" hardening pass) -----
# Soft cap on how many audits can be "processing" at once on this
# instance (see the process route's acquireProcessingSlot / migration
# 0009's try_lock_audit_processing). 3 is a conservative starting point
# for a Render Starter-sized instance (0.5 CPU / 512MB) — not a measured
# ceiling. Tune once you've actually load-tested a real deploy.
MAX_CONCURRENT_AUDITS=3

# Lifetime free-audit cap per account, per audit type (Deep costs more —
# vision calls, competitor fetch, website fetch on top of the same 9
# stages a Quick Audit runs — hence the lower default). These are
# starting guesses, not a business decision — set them explicitly once
# the real numbers are decided. Either can be set to 0 to disable that
# cap entirely. See src/lib/actions/audits.ts.
MAX_FREE_QUICK_AUDITS_PER_ACCOUNT=5
MAX_FREE_DEEP_AUDITS_PER_ACCOUNT=2

# Optional — real per-audit token usage is always recorded (see
# /admin/system) regardless of these; setting both additionally shows an
# estimated dollar cost. Get current pricing from your own OpenAI billing
# dashboard or platform.openai.com/docs/pricing — never guessed here,
# since it can drift and depends on your account's actual rate. Price per
# 1,000,000 tokens, in USD. See src/lib/ai/costEstimate.ts.
# OPENAI_INPUT_PRICE_PER_1M=
# OPENAI_OUTPUT_PRICE_PER_1M=

# Optional — Cloudflare Turnstile bot protection on signup. There is
# currently no CAPTCHA/bot protection at all; without these two set,
# signup behaves exactly as before (inert, not "failing open" on a real
# check). Get a free site key + secret key at
# https://dash.cloudflare.com/?to=/:account/turnstile — see
# src/lib/security/turnstile.ts.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
