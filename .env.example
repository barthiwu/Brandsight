# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already covered by .gitignore's `.env*` rule.

# --- Supabase ---------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The publishable/anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# The secret/service_role key — server-only, bypasses Row Level Security.
# NEVER expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to gpt-5.6-luna (see src/lib/ai/client.ts) if unset.
OPENAI_MODEL=gpt-5.6-luna

# --- App ------------------------------------------------------------------
# Used to build absolute URLs (share links, sitemap, metadata, robots.txt).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of emails granted access to /admin
# (see src/lib/security/adminAuth.ts).
ADMIN_EMAILS=you@example.com

# Supabase Storage bucket used for uploaded brand assets
# (created by supabase/migrations/0006_storage.sql).
STORAGE_BUCKET_NAME=brand-assets

# --- Lead notifications (BlitzSMA funnel) ---------------------------------
# Optional — when both are set, the auditing team gets an email whenever a
# new lead lands (from either the public shared-report form or the
# self-audit opt-in on a completed audit's own report page). Left unset,
# lead capture still works exactly the same; the team just has to check
# /admin/leads manually instead of getting notified. Get a key at
# https://resend.com — see src/lib/notifications/leadNotification.ts.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
LEAD_NOTIFICATION_EMAIL=team@example.com
# Optional — defaults to Resend's own onboarding sender (works with no
# setup). Switch to your own domain once it's verified in Resend.
# LEAD_NOTIFICATION_FROM_EMAIL=BrandSight <leads@yourdomain.com>
